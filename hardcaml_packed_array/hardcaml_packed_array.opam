opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/hardcaml_packed_array"
bug-reports: "https://github.com/janestreet/hardcaml_packed_array/issues"
dev-repo: "git+https://github.com/janestreet/hardcaml_packed_array.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/hardcaml_packed_array/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.1.0"}
  "base"
  "hardcaml"
  "ppx_jane"
  "dune"     {>= "3.17.0"}
]
available: arch != "x86_32"
synopsis: "Hardcaml interfaces as packed array"
description: "
Hardcaml Interfaces packed into arrays for use in register banks
"
